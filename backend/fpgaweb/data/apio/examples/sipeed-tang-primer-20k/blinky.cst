//
// icebreaker 7-seg PMOD v1.1a on the Lite top-right PMOD.
//
//   1 AA T6   2 AB T7   3 AC T8   4 AD T9   5 GND   6 3V3
//   7 AE P6   8 AF R8   9 AG P8  10 CAT P9 11 GND  12 3V3
//
// Segments active-low. CAT=1 selects the right-hand digit.
//------------------------------------------------------------------

IO_LOC  "sys_clk" H11;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33;

IO_LOC  "seven_seg[0]" T6;   // AA  segment A (top bar); blinks
IO_LOC  "seven_seg[1]" T7;   // AB
IO_LOC  "seven_seg[2]" T8;   // AC
IO_LOC  "seven_seg[3]" T9;   // AD
IO_LOC  "seven_seg[4]" P6;   // AE
IO_LOC  "seven_seg[5]" R8;   // AF
IO_LOC  "seven_seg[6]" P8;   // AG
IO_LOC  "seven_seg[7]" P9;   // CAT
IO_PORT "seven_seg[0]" IO_TYPE=LVCMOS33;
IO_PORT "seven_seg[1]" IO_TYPE=LVCMOS33;
IO_PORT "seven_seg[2]" IO_TYPE=LVCMOS33;
IO_PORT "seven_seg[3]" IO_TYPE=LVCMOS33;
IO_PORT "seven_seg[4]" IO_TYPE=LVCMOS33;
IO_PORT "seven_seg[5]" IO_TYPE=LVCMOS33;
IO_PORT "seven_seg[6]" IO_TYPE=LVCMOS33;
IO_PORT "seven_seg[7]" IO_TYPE=LVCMOS33;

// Per https://github.com/YosysHQ/nextpnr/issues/1515
CLOCK_LOC "sys_clk" BUFG;
